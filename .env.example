# ==========================================
# AGENT HUB — exemplo de variáveis de ambiente
# ==========================================
# Copie este arquivo para:
#   - backend/.env   (variáveis do backend / scripts)
#   - frontend/.env  (apenas as variáveis REACT_APP_*)
# NUNCA commite .env reais no Git.

# ==========================================
# FRONTEND (públicas — expostas no bundle do React)
# ==========================================
# Local:   http://localhost:8001
# Produção: https://<seu-dominio>.vercel.app
REACT_APP_BACKEND_URL=http://localhost:8001
# Token usado para consultar o histórico/knowledge base público (mesmo valor de API_HISTORY_TOKEN abaixo).
REACT_APP_API_HISTORY_TOKEN=substitua-por-um-token-seguro

# ==========================================
# BANCO DE DADOS — BACKEND
# ==========================================
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<senha>@<cluster>.mongodb.net/?appName=<app>
MONGO_URL=mongodb://localhost:27017
DB_NAME=agenthub

# ==========================================
# SEGURANÇA — BACKEND
# ==========================================
# Gere algo forte: `openssl rand -hex 32`
JWT_SECRET=substitua-por-um-secret-de-pelo-menos-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=30
# Token compartilhado com o n8n para endpoints públicos de consulta (/api/kb, /api/history).
API_HISTORY_TOKEN=substitua-por-um-token-seguro

# ==========================================
# STRIPE
# ==========================================
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# ==========================================
# SENDGRID
# ==========================================
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@seu-dominio.com

# ==========================================
# ELEVENLABS
# ==========================================
ELEVENLABS_API_KEY=

# ==========================================
# N8N — orquestração externa
# ==========================================
# Base de todos os webhooks (pode ser sobrescrito por URL completa abaixo).
N8N_WEBHOOK_BASE=https://corefy.app.n8n.cloud/webhook
# Overrides opcionais — deixe em branco para usar N8N_WEBHOOK_BASE + sufixo default.
N8N_WEBHOOK_ECOMMERCE=
N8N_WEBHOOK_SDR=
N8N_WEBHOOK_SUPORTE=
N8N_WEBHOOK_POS_VENDAS=
N8N_WEBHOOK_LIDIA_PROSPEC=
N8N_WEBHOOK_TITLE=

# ==========================================
# SDR SCHEDULER
# ==========================================
SDR_SCHEDULER_TZ=America/Sao_Paulo

# ==========================================
# CORS E SERVIDOR
# ==========================================
# Lista separada por vírgulas. Use '*' apenas em desenvolvimento — em produção
# '*' desliga automaticamente allow_credentials por exigência do CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://seu-dominio.vercel.app
APP_ENV=development
BASE_URL=http://localhost:8000

# ==========================================
# UPLOADS
# ==========================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ==========================================
# SEED (opcional — usado por scripts/seed_data.py)
# ==========================================
SEED_ADMIN_EMAIL=admin@voiceai.com
SEED_ADMIN_PASSWORD=troque-em-producao
