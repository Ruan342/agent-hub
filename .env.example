# ==========================================
# GERAL - FRONTEND (Variável Pública no Vercel)
# ==========================================
# Ao desenvolver localmente: http://localhost:8001
# Ao publicar no Vercel, o Vercel pode exigir o nome real de seu site, Ex: https://seu-site-agenthub.vercel.app
REACT_APP_BACKEND_URL=http://localhost:8001

# ==========================================
# SEGURANÇA E BANCO DE DADOS - BACKEND
# ==========================================
MONGO_URL=mongodb://localhost:27017
DB_NAME=agenthub
JWT_SECRET=escreva_um_secret_seguro_aqui_para_tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
API_HISTORY_TOKEN=agent-hub-secret-token

# ==========================================
# GATEWAYS E INTEGRAÇÕES EXTERNAS - BACKEND
# ==========================================
# Adicione suas próprias chaves de produção:
ELEVENLABS_API_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ==========================================
# CORS E SERVIDOR - BACKEND
# ==========================================
# Insira a URL do Vercel quando disponível para liberar comunicações cross-origin com segurança
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://seu-dominio.vercel.app
